<main class="wrap narrow">
  <a class="back" href="/">← Board</a>
  <div class="page-head" style="margin-top:10px">
    <h1>Edit <%= item.name %></h1>
    <p class="muted">Nothing goes live yet. Leave the time empty to save a <strong>draft</strong>, or pick a time to <strong>schedule</strong> it.</p>
  </div>

  <% if error %>
    <div class="flash flash-error">Nothing to stage — no fields changed, or a value was invalid.</div>
  <% end %>

  <div class="edit-layout">
    <form class="form card" method="post" action="/items/<%= item.id %>/changes">
      <label>Name
        <input type="text" name="name" id="f-name" value="<%= item.name %>">
      </label>
      <label>Description
        <textarea name="description" id="f-desc"><%= item.description %></textarea>
      </label>
      <label>Price (£)
        <input type="text" name="price" id="f-price" value="<%= format("%.2f", item.price_cents / 100.0) %>">
      </label>
      <label>Availability
        <select name="available" id="f-avail">
          <option value="1" <%= "selected" if item.available %>>Available</option>
          <option value="0" <%= "selected" unless item.available %>>Unavailable</option>
        </select>
      </label>
      <label>Apply at
        <input type="datetime-local" name="apply_at" id="f-when">
        <span class="hint">Empty = draft · A time = scheduled</span>
      </label>
      <button class="btn btn-primary" type="submit">Stage change</button>
    </form>

    <aside class="preview card">
      <span class="preview-label">Live preview</span>
      <h2 id="p-name"><%= item.name %></h2>
      <p class="desc" id="p-desc"><%= item.description %></p>
      <div class="card-bottom">
        <span class="price" id="p-price"></span>
        <span class="badge" id="p-avail"></span>
      </div>
    </aside>
  </div>
</main>

<script>
  (function () {
    var ids = ["f-name", "f-desc", "f-price", "f-avail"];
    function sync() {
      document.getElementById("p-name").textContent = document.getElementById("f-name").value || "—";
      document.getElementById("p-desc").textContent = document.getElementById("f-desc").value || "";
      var p = parseFloat(document.getElementById("f-price").value);
      document.getElementById("p-price").textContent = isNaN(p) ? "—" : "£" + p.toFixed(2);
      var ok = document.getElementById("f-avail").value === "1";
      var b = document.getElementById("p-avail");
      b.textContent = ok ? "Available" : "Unavailable";
      b.className = "badge " + (ok ? "badge-ok" : "badge-off");
    }
    ids.forEach(function (id) {
      var el = document.getElementById(id);
      el.addEventListener("input", sync);
      el.addEventListener("change", sync);
    });
    sync();
  })();
</script>
