<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slate — café menu board</title>
    <style>
      :root {
        --bg: #f6f3ee; --panel: #fffdf9; --ink: #2b2622; --muted: #8a7f73;
        --line: #e7ddd0; --brand: #b5651d; --brand-ink: #fff;
        --accent: #2f6f4f; --draft: #9a7b12; --sched: #2f6f4f; --danger: #a23b2d;
        --shadow: 0 1px 2px rgba(50,40,30,.06), 0 6px 20px rgba(50,40,30,.06);
        --radius: 14px;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1a1714; --panel: #241f1b; --ink: #efe7db; --muted: #a99c8c;
          --line: #372f28; --brand: #d98b45; --brand-ink: #1a1714;
          --accent: #5fae83; --draft: #d8b64a; --sched: #5fae83; --danger: #e06a58;
          --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.35);
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      .topbar {
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px 22px; background: var(--panel); border-bottom: 1px solid var(--line);
        position: sticky; top: 0; z-index: 5;
      }
      .brand { font-weight: 700; letter-spacing: .3px; display: flex; align-items: center; gap: 8px; }
      .brand .logo { color: var(--brand); font-size: 20px; }
      .topbar nav { display: flex; gap: 6px; }
      .topbar nav a {
        text-decoration: none; color: var(--muted); font-weight: 600; font-size: 14px;
        padding: 7px 12px; border-radius: 9px;
      }
      .topbar nav a:hover { background: var(--bg); color: var(--ink); }
      .wrap { max-width: 980px; margin: 0 auto; padding: 30px 22px 60px; }
      .wrap.narrow { max-width: 720px; }
      .page-head h1 { margin: 0 0 4px; font-size: 28px; letter-spacing: -.4px; }
      .muted { color: var(--muted); margin: 0 0 22px; }
      .back { color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 600; }

      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
      .card {
        background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
        box-shadow: var(--shadow); padding: 18px;
      }
      .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
      .card h2 { margin: 0; font-size: 18px; }
      .desc { color: var(--muted); font-size: 14px; margin: 8px 0 16px; min-height: 20px; }
      .card-bottom { display: flex; align-items: center; justify-content: space-between; }
      .price { font-weight: 700; font-size: 20px; font-variant-numeric: tabular-nums; }

      .badge {
        font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
        padding: 4px 9px; border-radius: 999px; white-space: nowrap;
      }
      .badge-pending, .badge-draft { background: color-mix(in srgb, var(--draft) 18%, transparent); color: var(--draft); }
      .badge-sched, .badge-ok { background: color-mix(in srgb, var(--sched) 18%, transparent); color: var(--sched); }
      .badge-off { background: color-mix(in srgb, var(--muted) 22%, transparent); color: var(--muted); }

      .btn {
        display: inline-block; border: 1px solid var(--line); background: var(--panel); color: var(--ink);
        font-weight: 600; font-size: 14px; padding: 8px 14px; border-radius: 10px;
        text-decoration: none; cursor: pointer;
      }
      .btn:hover { border-color: var(--muted); }
      .btn-primary { background: var(--brand); color: var(--brand-ink); border-color: var(--brand); }
      .btn-primary:hover { filter: brightness(1.05); }
      .btn-ghost { background: transparent; }

      .flash { padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 14px; }
      .flash-error { background: color-mix(in srgb, var(--danger) 14%, transparent); color: var(--danger); }

      .edit-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: start; }
      @media (max-width: 640px) { .edit-layout { grid-template-columns: 1fr; } }
      .form label { display: block; font-weight: 600; font-size: 13px; color: var(--muted); margin-bottom: 14px; }
      .form input, .form textarea, .form select {
        display: block; width: 100%; margin-top: 6px; padding: 10px 12px; font: inherit;
        color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
      }
      .form textarea { min-height: 62px; resize: vertical; }
      .form .hint { display: block; margin-top: 6px; font-weight: 500; color: var(--muted); font-size: 12px; }
      .form .btn-primary { width: 100%; margin-top: 4px; }
      .preview { position: sticky; top: 84px; }
      .preview-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; color: var(--muted); }
      .preview h2 { margin: 10px 0 0; }

      .section { font-size: 14px; text-transform: uppercase; letter-spacing: .6px; color: var(--muted); margin: 26px 0 12px; }
      .changes { display: grid; gap: 14px; }
      .change-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
      .change-head h3 { margin: 0; font-size: 17px; }
      .diffs { list-style: none; padding: 0; margin: 14px 0; display: grid; gap: 8px; }
      .diffs li { display: flex; align-items: center; gap: 10px; font-size: 14px; }
      .diffs .field { color: var(--muted); text-transform: capitalize; min-width: 90px; }
      .diffs .before { text-decoration: line-through; color: var(--muted); }
      .diffs .after { font-weight: 700; }
      .diffs .arrow { color: var(--brand); }
      .change-actions { display: flex; gap: 8px; border-top: 1px solid var(--line); padding-top: 14px; }
      .change-actions form { margin: 0; }
      .empty { text-align: center; color: var(--muted); padding: 50px; border: 1px dashed var(--line); border-radius: var(--radius); }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="brand"><span class="logo">◱</span> Slate</div>
      <nav>
        <a href="/">Board</a>
        <a href="/changes">Pending changes</a>
      </nav>
    </header>
    <%= yield %>
  </body>
</html>
